      <ChainBlock id="8f0a1a4376f543718f66b6c7b9802d64" type="ir" enabled="1" normalize="1"
                  inputGain="0.5" outputGain="0.5" mix="0.5" toneId="65088" toneJson="{&#13;&#10;  &quot;id&quot;: 65088,&#13;&#10;  &quot;user_id&quot;: &quot;0f9804a4-488f-4293-97fb-f20415ecc599&quot;,&#13;&#10;  &quot;title&quot;: &quot;Echo Fix EF X2&quot;,&#13;&#10;  &quot;description&quot;: &quot;A modern take on that classic analog tape sound! The sound that has been used by eveyone from Lee \&quot;Scratch\&quot; Perry, to Kevin Parker and Brian Eno.\n\nEcho Fix grew from one of the most well-respected repairers of vintage units to creating their own, including the EF X2. From subtle slap backs, to crazy swirling tape feedback, they're great as an instrument effect or in a mix. \n\nRecorded through an API 548C preamp. &quot;,&#13;&#10;  &quot;created_at&quot;: &quot;2026-05-03T21:43:54.886452+00:00&quot;,&#13;&#10;  &quot;updated_at&quot;: &quot;2026-07-24T17:17:40.073+00:00&quot;,&#13;&#10;  &quot;images&quot;: [&#13;&#10;    &quot;https://api.tone3000.com/storage/v1/object/public/images/yzr8w13yksk.jpg&quot;&#13;&#10;  ],&#13;&#10;  &quot;is_public&quot;: true,&#13;&#10;  &quot;links&quot;: [],&#13;&#10;  &quot;models_count&quot;: 1,&#13;&#10;  &quot;favorites_count&quot;: 9,&#13;&#10;  &quot;downloads_count&quot;: 226,&#13;&#10;  &quot;license&quot;: &quot;t3k&quot;,&#13;&#10;  &quot;sizes&quot;: null,&#13;&#10;  &quot;a1_models_count&quot;: 0,&#13;&#10;  &quot;a2_models_count&quot;: 0,&#13;&#10;  &quot;irs_count&quot;: 1,&#13;&#10;  &quot;custom_models_count&quot;: 0,&#13;&#10;  &quot;user&quot;: {&#13;&#10;    &quot;id&quot;: &quot;0f9804a4-488f-4293-97fb-f20415ecc599&quot;,&#13;&#10;    &quot;avatar_url&quot;: &quot;https://api.tone3000.com/storage/v1/object/public/avatars/d1e9gybqbfa.png&quot;,&#13;&#10;    &quot;username&quot;: &quot;tone3000&quot;,&#13;&#10;    &quot;url&quot;: &quot;https://www.tone3000.com/tone3000&quot;&#13;&#10;  },&#13;&#10;  &quot;makes&quot;: [&#13;&#10;    {&#13;&#10;      &quot;id&quot;: 42642,&#13;&#10;      &quot;name&quot;: &quot;API 548C preamp&quot;&#13;&#10;    },&#13;&#10;    {&#13;&#10;      &quot;id&quot;: 51956,&#13;&#10;      &quot;name&quot;: &quot;Echo Fix EF-X2&quot;&#13;&#10;    }&#13;&#10;  ],&#13;&#10;  &quot;tags&quot;: [&#13;&#10;    {&#13;&#10;      &quot;id&quot;: 68815,&#13;&#10;      &quot;name&quot;: &quot;delay&quot;&#13;&#10;    },&#13;&#10;    {&#13;&#10;      &quot;id&quot;: 108246,&#13;&#10;      &quot;name&quot;: &quot;echo&quot;&#13;&#10;    },&#13;&#10;    {&#13;&#10;      &quot;id&quot;: 15,&#13;&#10;      &quot;name&quot;: &quot;ir&quot;&#13;&#10;    },&#13;&#10;    {&#13;&#10;      &quot;id&quot;: 91232,&#13;&#10;      &quot;name&quot;: &quot;tape delay&quot;&#13;&#10;    }&#13;&#10;  ],&#13;&#10;  &quot;url&quot;: &quot;https://www.tone3000.com/tones/echo-fix-ef-x2-65088&quot;,&#13;&#10;  &quot;format&quot;: &quot;ir&quot;,&#13;&#10;  &quot;gear&quot;: &quot;outboard&quot;,&#13;&#10;  &quot;models&quot;: [&#13;&#10;    {&#13;&#10;      &quot;id&quot;: 378645,&#13;&#10;      &quot;tone_id&quot;: 65088,&#13;&#10;      &quot;user_id&quot;: &quot;0f9804a4-488f-4293-97fb-f20415ecc599&quot;,&#13;&#10;      &quot;created_at&quot;: &quot;2026-05-03T21:43:55.118341+00:00&quot;,&#13;&#10;      &quot;updated_at&quot;: &quot;2026-05-03T21:43:55.118341+00:00&quot;,&#13;&#10;      &quot;name&quot;: &quot;Echo Fix EF -X2&quot;,&#13;&#10;      &quot;model_url&quot;: &quot;https://www.tone3000.com/api/v1/models/378645/download/euxjx0nqztg.wav&quot;,&#13;&#10;      &quot;size&quot;: null,&#13;&#10;      &quot;architecture_version&quot;: null&#13;&#10;    }&#13;&#10;  ]&#13;&#10;}"
