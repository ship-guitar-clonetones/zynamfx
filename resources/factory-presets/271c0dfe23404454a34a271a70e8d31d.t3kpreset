    <RightChainBlocks>
      <ChainBlock id="fbd7c57da2624bb98f1c722c7a978400" type="ir" enabled="1" normalize="1"
                  inputGain="0.5" outputGain="0.5" mix="0.5" toneId="71073" toneJson="{&#13;&#10;  &quot;id&quot;: 71073,&#13;&#10;  &quot;user_id&quot;: &quot;0f9804a4-488f-4293-97fb-f20415ecc599&quot;,&#13;&#10;  &quot;title&quot;: &quot;The Green-Wood Cemetery Catacombs&quot;,&#13;&#10;  &quot;description&quot;: &quot;A rare capture of the Green-Wood Cemetery catacombs: stone vaults, narrow corridors, and a long, eerie natural decay. Green-Wood Cemetery, founded in 1838, is one of New York City&#8217;s most historic landmarks, known for its dramatic landscape design and iconic architecture. Beneath its rolling hills sit the Catacombs: 30 underground vaults dating back to the early 1850s, sealed behind iron gates and built from dense stone that creates an unmistakable natural decay.\n\nOur impulse responses were captured on location at the Green-Wood Cemetery Catacombs. The mono IR was recorded with a Neumann MA 1, while the stereo IR was recorded with a Lauten Audio LA-120 pair to capture wider spatial detail and decay.&quot;,&#13;&#10;  &quot;created_at&quot;: &quot;2026-06-12T20:55:26.964339+00:00&quot;,&#13;&#10;  &quot;updated_at&quot;: &quot;2026-07-24T18:12:47.465+00:00&quot;,&#13;&#10;  &quot;images&quot;: [&#13;&#10;    &quot;https://api.tone3000.com/storage/v1/object/public/images/arg3zpo1we.jpg&quot;&#13;&#10;  ],&#13;&#10;  &quot;is_public&quot;: true,&#13;&#10;  &quot;links&quot;: [&#13;&#10;    &quot;https://www.youtube.com/watch?v=dcUouJZexRk&quot;&#13;&#10;  ],&#13;&#10;  &quot;models_count&quot;: 9,&#13;&#10;  &quot;favorites_count&quot;: 24,&#13;&#10;  &quot;downloads_count&quot;: 505,&#13;&#10;  &quot;license&quot;: &quot;t3k&quot;,&#13;&#10;  &quot;sizes&quot;: null,&#13;&#10;  &quot;a1_models_count&quot;: 0,&#13;&#10;  &quot;a2_models_count&quot;: 0,&#13;&#10;  &quot;irs_count&quot;: 9,&#13;&#10;  &quot;custom_models_count&quot;: 0,&#13;&#10;  &quot;user&quot;: {&#13;&#10;    &quot;id&quot;: &quot;0f9804a4-488f-4293-97fb-f20415ecc599&quot;,&#1