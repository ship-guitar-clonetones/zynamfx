      <ChainBlock id="4342c1c231184882b16fad47649c70ff" type="ir" enabled="1" normalize="1"
                  inputGain="0.5" outputGain="0.5" mix="1.0" toneId="62037" toneJson="{&#13;&#10;  &quot;id&quot;: 62037,&#13;&#10;  &quot;user_id&quot;: &quot;0f9804a4-488f-4293-97fb-f20415ecc599&quot;,&#13;&#10;  &quot;title&quot;: &quot;Marshall 1960 Lead with Fane Speakers&quot;,&#13;&#10;  &quot;description&quot;: &quot;The Marshall 1960 series of cabinets are THE quintessential Marshall cab. Designed to offer higher power and more volume than existing combos, these cabs have been used by artists like Angus Young, Ray Toro Billie Joe Armstrong,, Joe Duplantier and Kurt Cobain.\n\nOur cab is paired with speakers from Fane Acoustics, a UK based company known for their top-of-class high gain speakers. \n\nOur impulse responses were captured using a Seymour Duncan Powerstage 170 and recorded with a Shure SM57, a Royer 122, and a Neumann u67, through Neve 33117 microphone preamps. All mics were positioned halfway between the cone center and edge and roughly 2 inches from the grill.\n\nGreat for high-gain, beefy or cutting tones!&quot;,&#13;&#10;  &quot;created_at&quot;: &quot;2026-04-16T19:46:17.933039+00:00&quot;,&#13;&#10;  &quot;updated_at&quot;: &quot;2026-05-29T22:21:29.073+00:00&quot;,&#13;&#10;  &quot;images&quot;: [&#13;&#10;    &quot;https://api.tone3000.com/storage/v1/object/public/images/4znbrk5h9k.jpg&quot;&#13;&#10;  ],&#13;&#10;  &quot;is_public&quot;: true,&#13;&#10;  &quot;links&quot;: [&#13;&#10;    &quot;https://youtu.be/fFM0DCxlEa8?si=7zCSiUSnFT_WBtPr&quot;&#13;&#10;  ],&#13;&#10;  &quot;models_count&quot;: 3,&#13;&#10;  &quot;favorites_count&quot;: 130,&#13;&#10;  &quot;downloads_count&quot;: 7398,&#13;&#10;  &quot;license&quot;: &quot;t3k&quot;,&#13;&#10;  &quot;sizes&quot;: null,&#13;&#10;  &quot;a1_models_count&quot;: 0,&#13;&#10;  &quot;a2_models_count&quot;: 0,&#13;&#10;  &quot;irs_count&quot;: 3,&#13;&#10;  &quot;custom_models_count&quot;: 0,&#13;&#10;  &quot;user&quot;: {&#13;&#10;    &quot;id&quot;: &quot;0f9804a4-488f-4293-97fb-f20415ecc