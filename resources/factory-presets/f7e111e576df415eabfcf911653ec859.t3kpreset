                  toneJson="{&#13;&#10;  &quot;id&quot;: 78773,&#13;&#10;  &quot;user_id&quot;: &quot;ae6edfee-ad38-4c5a-be5d-08d3401d72c8&quot;,&#13;&#10;  &quot;title&quot;: &quot;Ibanez TS9 Pedal&quot;,&#13;&#10;  &quot;description&quot;: &quot;Its a fairly modern TS9.\n\nThe nam model sounds pretty close to the sound you get from the pedal using a amp.\nThe pedal has a very transistor distortion sound to it.\n&quot;,&#13;&#10;  &quot;created_at&quot;: &quot;2026-07-29T13:27:45.213951+00:00&quot;,&#13;&#10;  &quot;updated_at&quot;: &quot;2026-07-29T15:44:20.886+00:00&quot;,&#13;&#10;  &quot;images&quot;: [&#13;&#10;    &quot;https://api.tone3000.com/storage/v1/object/public/images/fko0fdi4vr.jpg&quot;&#13;&#10;  ],&#13;&#10;  &quot;is_public&quot;: true,&#13;&#10;  &quot;links&quot;: [],&#13;&#10;  &quot;models_count&quot;: 0,&#13;&#10;  &quot;favorites_count&quot;: 37,&#13;&#10;  &quot;downloads_count&quot;: 445,&#13;&#10;  &quot;license&quot;: &quot;t3k&quot;,&#13;&#10;  &quot;sizes&quot;: null,&#13;&#10;  &quot;a1_models_count&quot;: 0,&#13;&#10;  &quot;a2_models_count&quot;: 3,&#13;&#10;  &quot;irs_count&quot;: 0,&#13;&#10;  &quot;custom_models_count&quot;: 0,&#13;&#10;  &quot;user&quot;: {&#13;&#10;    &quot;id&quot;: &quot;ae6edfee-ad38-4c5a-be5d-08d3401d72c8&quot;,&#13;&#10;    &quot;avatar_url&quot;: &quot;https://api.tone3000.com/storage/v1/object/public/avatars/5akekslzzem.jpg&quot;,&#13;&#10;    &quot;username&quot;: &quot;scottabaillie&quot;,&#13;&#10;    &quot;url&quot;: &quot;https://www.tone3000.com/scottabaillie&quot;&#13;&#10;  },&#13;&#10;  &quot;makes&quot;: [&#13;&#10;    {&#13;&#10;      &quot;id&quot;: 5514,&#13;&#10;      &quot;name&quot;: &quot;Ibanez TS9&quot;&#13;&#10;    },&#13;&#10;    {&#13;&#10;      &quot;id&quot;: 159,&#13;&#10;      &quot;name&quot;: &quot;Ibanez TS9 Tube Screamer&quot;&#13;&#10;    }&#13;&#10;  ],&#13;&#10;  &quot;tags&quot;: [&#13;&#10;    {&#13;&#10;      &quot;id&quot;: 245,&#13;&#10;      &quot;name&quot;: &q