      <ChainBlock id="300f620a36a94171961aea23bb286ea9" type="nam" enabled="1"
                  normalize="1" inputGain="0.5" outputGain="0.5" mix="1.0" toneId="61106"
                  toneJson="{&#13;&#10;  &quot;id&quot;: 61106,&#13;&#10;  &quot;user_id&quot;: &quot;23d37347-61c3-4a15-bbec-4b145802bb6f&quot;,&#13;&#10;  &quot;title&quot;: &quot;EHX Big Muff Pi&quot;,&#13;&#10;  &quot;description&quot;: &quot;This pack contains 25 different captures of the EHX Big Muff Pi.\n\nT = Tone\nS = Sustain (Fuzz)\n\nI used only one position for the volume as that can be changed through the NAM plugins to do the same thing. There are 5 different positions for Tone and Sustain.\n\nI wasn't keen on having so many files, but the BMP has such a huge range of sounds that its kind of difficult to capture its full potential without going a little overboard.\n\nTrained on feather with 800 epochs\n\nEnjoy! :)&quot;,&#13;&#10;  &quot;created_at&quot;: &quot;2026-04-10T11:38:41.426655+00:00&quot;,&#13;&#10;  &quot;updated_at&quot;: &quot;2026-04-10T11:38:41.426655+00:00&quot;,&#13;&#10;  &quot;images&quot;: [&#13;&#10;    &quot;https://api.tone3000.com/storage/v1/object/public/images/jrm56t9ov8e.jpg&quot;&#13;&#10;  ],&#13;&#10;  &quot;is_public&quot;: true,&#13;&#10;  &quot;links&quot;: [],&#13;&#10;  &quot;models_count&quot;: 25,&#13;&#10;  &quot;favorites_count&quot;: 46,&#13;&#10;  &quot;downloads_count&quot;: 1998,&#13;&#10;  &quot;license&quot;: &quot;t3k&quot;,&#13;&#10;  &quot;sizes&quot;: [&#13;&#10;    &quot;feather&quot;&#13;&#10;  ],&#13;&#10;  &quot;a1_models_count&quot;: 25,&#13;&#10;  &quot;a2_models_count&quot;: 25,&#13;&#10;  &quot;irs_count&quot;: 0,&#13;&#10;  &quot;custom_models_count&quot;: 0,&#13;&#10;  &quot;user&quot;: {&#13;&#10;    &quot;id&quot;: &quot;23d37347-61c3-4a15-bbec-4b145802bb6f&quot;,&#13;&#10;    &quot;avatar_url&quot;: &quot;https://api.tone3000.com/storage/v1/object/public/avatars/hj50ml0o5dd.jpg&quot;,&#13;&#10;    &quot;username&quot;: &quot;ethanmh&quot;,&#13;&#10;    &quot;url&quot;: &quot;https://www.tone3000.com/ethanmh&quot;&#13;&#10;  },&#13;&#10;  &quot;makes&quot;: [&#13;&#10;    {&#13;&#10;      &q