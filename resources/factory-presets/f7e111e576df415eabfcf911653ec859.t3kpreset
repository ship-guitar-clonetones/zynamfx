      <ChainBlock id="e7b8ae283ce14308a9ccf1052dea1a10" type="nam" enabled="1"
                  normalize="1" inputGain="0.5" outputGain="0.5" mix="1.0" toneId="78180"
                  toneJson="{&#13;&#10;  &quot;id&quot;: 78180,&#13;&#10;  &quot;user_id&quot;: &quot;6ab581a2-9efe-4122-a50a-01fce9fdfeae&quot;,&#13;&#10;  &quot;title&quot;: &quot;PV EVH - Gremlin Annihilation Pack (A2 Native)&quot;,&#13;&#10;  &quot;description&quot;: &quot;I am late to the A2 party because of a wide variety of Gremlins....\n\nGremlins in my recording setup, Gremlins in my tubes, Gremlins in learning the intricacies of A2, Gremlins everywhere.\n\nBut alas they have been annihilated and a trio pack of my 65 style amps has arrived in their place. \n\nIn all seriousness, these captures are highly curated. We are talking 200+ captures painstakingly whittled down to 28. These are the last ones standing. \n\nSignal Chain: Clarett 2Pre -&gt; Signal Art Reamp -&gt; Amp Chain -&gt; Suhr 8ohm Reload -&gt; Clarett 2Pre\n\nCalibration: Roughly +14dBU (Use your ears)&quot;,&#13;&#10;  &quot;created_at&quot;: &quot;2026-07-26T13:18:41.909188+00:00&quot;,&#13;&#10;  &quot;updated_at&quot;: &quot;2026-07-26T13:19:04.501+00:00&quot;,&#13;&#10;  &quot;images&quot;: [&#13;&#10;    &quot;https://api.tone3000.com/storage/v1/object/public/images/7if4hgt1y0m.jpg&quot;&#13;&#10;  ],&#13;&#10;  &quot;is_public&quot;: true,&#13;&#10;  &quot;links&quot;: [&#13;&#10;    &quot;https://youtu.be/Bz1WXiyVBK0&quot;&#13;&#10;  ],&#13;&#10;  &quot;models_count&quot;: 0,&#13;&#10;  &quot;favorites_count&quot;: 131,&#13;&#10;  &quot;downloads_count&quot;: 2097,&#13;&#10;  &quot;license&quot;: &quot;t3k&quot;,&#13;&#10;  &quot;sizes&quot;: null,&#13;&#10;  &quot;a1_models_count&quot;: 0,&#13;&#10;  &quot;a2_models_count&quot;: 28,&#13;&#10;  &quot;irs_count&quot;: 0,&#13;&#10;  &quot;custom_models_count&quot;: 0,&#13;&#10;  &quot;user&quot;: {&#13;&#10;    &quot;id&quot;: &quot;6ab581a2-9efe-4122-a50a-01fce9fdfeae&quot;,&#13;&#10;    &quot;avatar_url&quot;: &quot;https://api.tone3000.com/storage/v1/object/public/avatars/helgab-1691425938.jpg&quot;,&#13;&#10;    &quot;username&quot;: 