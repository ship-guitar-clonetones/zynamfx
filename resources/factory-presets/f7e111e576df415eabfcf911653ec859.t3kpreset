      <ChainBlock id="be140e5c43d84429ab87708a51441ed6" type="nam" enabled="0"
                  normalize="1" inputGain="0.5" outputGain="0.5" mix="1.0" toneId="77706"
                  toneJson="{&#13;&#10;  &quot;id&quot;: 77706,&#13;&#10;  &quot;user_id&quot;: &quot;c5b78330-855e-4f97-8691-ad0c2b49dfa7&quot;,&#13;&#10;  &quot;title&quot;: &quot;1966 Marshall 1962 Bluesbreaker (JTM45) with G12 Alnico - CRUNCH - A2&quot;,&#13;&#10;  &quot;description&quot;: &quot;Get the full capture pack for this amp here: https://www.amalgamcaptures.com/nam\n\nSubscribe to our NEWSLETTER to be in the loop on new releases!\n\nAMP SETTINGS:\nP2 B2.5 M8 T7 VI6.5 VII5\n\nCAB:\nMarshall RI 1962 Bluesbreaker 2X12 with vintage G12 Alnico speakers (original Pulsonic cones)\n\nMICS:\nR121, R160, U87\n\nDESCRIPTION:\nTHere's not many guitar tones that reach the status of a true legend. The infamous Clapton Beano tone is without a doubt one of those. It is a simple setup, but the gear involved is unobtainable. A truly historically significant tone at your fingertips right here.&quot;,&#13;&#10;  &quot;created_at&quot;: &quot;2026-07-24T11:58:49.214971+00:00&quot;,&#13;&#10;  &quot;updated_at&quot;: &quot;2026-07-24T14:07:38.449+00:00&quot;,&#13;&#10;  &quot;images&quot;: [&#13;&#10;    &quot;https://api.tone3000.com/storage/v1/object/public/images/p5uwsf53bw.jpg&quot;&#13;&#10;  ],&#13;&#10;  &quot;is_public&quot;: true,&#13;&#10;  &quot;links&quot;: [&#13;&#10;    &quot;https://www.amalgamcaptures.com/product-page/beano-pack-namcaba2&quot;,&#13;&#10;    &quot;https://youtu.be/WaCCJRHbUXI&quot;&#13;&#10;  ],&#13;&#10;  &quot;models_count&quot;: 0,&#13;&#10;  &quot;favorites_count&quot;: 226,&#13;&#10;  &quot;downloads_count&quot;: 7114,&#13;&#10;  &quot;license&quot;: &quot;t3k&quot;,&#13;&#10;  &quot;sizes&quot;: null,&#13;&#10;  &quot;a1_models_count&quot;: 0,&#13;&#10;  &quot;a2_models_count&quot;: 1,&#13;&#10;  &quot;irs_count&quot;: 0,&#13;&#10;  &quot;custom_models_count&quot;: 0,&#13;&#10;  &quot;user&quot;: {&#13;&#10;    &quot;id&quot;: &quot;c5b78330-855e-4f97-8691-ad0c2b49dfa7&quot;,&#13;&#10;    &quot;avatar_url&quot;: &quot;https://api.tone30